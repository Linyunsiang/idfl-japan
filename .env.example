# IDFL JAPAN - access control (set these in Netlify > Site settings > Environment variables)
# Do NOT commit real values. .env is gitignored.
CUSTOMER_ACCESS_PASSWORD=your_customer_password
STAFF_ACCESS_PASSWORD=your_staff_password
SESSION_SECRET=your_random_session_secret

# --- Media Library feedback notification (optional) -------------------------
# Feedback is ALWAYS saved first; e-mail is best-effort and its failure can
# never lose a submission. Leave these unset and the feature still works - the
# API simply reports notificationSent:false and staff read the feedback in
# /admin instead.
#
# Provider: Resend (https://resend.com). The sending domain must be verified
# with the provider before FEEDBACK_FROM will be accepted.
RESEND_API_KEY=your_resend_api_key
FEEDBACK_NOTIFY_TO=someone@example.com
FEEDBACK_FROM=IDFL JAPAN <noreply@your-verified-domain.example>
